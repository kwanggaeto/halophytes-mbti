{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "halophytes-mbti",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
